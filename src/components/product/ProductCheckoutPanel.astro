---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          {product.title}
        </h2>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-2">
      <p class="text-sm leading-relaxed text-muted-foreground">{product.subtitle}</p>

      <div class="rounded-xl border border-border bg-background/80 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Product features</p>
        <p class="mt-1 text-sm text-foreground">Explore what&rsquo;s included</p>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
          {
            product.features.slice(0, 6).map((feature) => (
              <li class="flex items-start gap-2">
                <Icon name="check" size={14} class="product-feature-check mt-0.5 shrink-0" />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        {
          product.more > 0 && (
            <p class="mt-3 text-xs text-muted-foreground">
              Plus {product.more} more modules in the full list below.
            </p>
          )
        }
      </div>

      <dl class="product-compat-list rounded-xl border border-border px-4 py-1 text-sm">
        {
          product.systemRequirements.slice(0, 3).map((req) => (
            <div class="product-compat-list__row">
              <dt class="product-compat-list__term">
                <ProductIconWell name={req.icon} iconSize={16} />
                Requirement
              </dt>
              <dd class="product-compat-list__detail">{req.text}</dd>
            </div>
          ))
        }
      </dl>

      <Button
        as="a"
        href={product.buyUrl}
        rel={product.buyUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
      >
        Buy Now
        <Icon name="arrowRight" size={17} />
      </Button>

      <p class="text-xs leading-relaxed text-muted-foreground">
        Plan selection and payment happen on the secure merchant checkout page.
      </p>
    </div>
  </div>
</aside>