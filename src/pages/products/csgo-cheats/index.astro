---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { productHub, productPages } from '../../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import ProductAddonCards from '../../../components/ProductAddonCards.astro';
import { PRIMARY_CHECKOUT_PATH } from '../../../config/checkout';
import { Button } from '@/components/starwind/button';
import Icon from '../../../components/icons/Icon.astro';
import { productPath } from '../../../utils/path';
import BlogShareBar from '../../../components/BlogShareBar.astro';
import PageSeoExpansion from '../../../components/PageSeoExpansion.astro';
import { productHubExpansion, expansionFaqsToSchema } from '../../../data/pageExpansions';
import { faqPageSchema } from '../../../utils/schema';

const seo = resolvePageSeo('/products/csgo-cheats/');
const hubFaqs = expansionFaqsToSchema(productHubExpansion.faqs);
const breadcrumbs = [
  { name: 'Homepage', path: '/' },
  { name: 'Product hub', path: productHub.path },
];

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="CSGO Cheats download – CSGOCheats logo"
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
    faqPageSchema(hubFaqs),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold normal-case md:text-4xl">CSGO Cheats Download: Complete, Aimbot &amp; ESP plans</h1>
        <p class="text-lg text-muted-foreground">
          CSGO cheats for PC. Compare Complete, Aimbot, and ESP wallhack, then checkout when the module list matches how you actually play.
        </p>
        <h2 class="text-xl font-semibold normal-case text-foreground">Compare CSGO cheat plans</h2>
        <p class="text-base text-muted-foreground">{t.products.subtitle}</p>
        <BlogShareBar title={seo.title} path={productHub.path} />
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {productPages.map((product) => (
          <CatalogCard
            label={cardLabel(product)}
            title={product.title}
            href={productPath(product.slug)}
            buyUrl={product.buyUrl}
            features={product.features}
            more={product.more}
            icon={cardIcon(product)}
            badge={product.badge}
            variant={product.variant}
            buyLabel={`Buy ${product.name} key`}
            viewLabel={`See ${product.name} modules`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-muted/10 py-10 md:py-14" aria-labelledby="product-features-hub-title">
    <div class="mx-auto max-w-6xl px-5">
      <h2 id="product-features-hub-title" class="font-[family-name:var(--font-heading)] text-2xl font-semibold">
        Product features
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
        See what is included across Complete, Aimbot, and ESP plans, then finish plan selection on the merchant checkout page.
      </p>
      <Button as="a" href={PRIMARY_CHECKOUT_PATH} rel="noopener noreferrer" variant="primary" size="lg" class="mt-6 rounded-xl">
        Buy Now
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </section>

  <ProductAddonCards />

  <PageSeoExpansion
    sections={productHubExpansion.sections}
    table={productHubExpansion.table}
    faqs={productHubExpansion.faqs}
    faqHeading="Plans FAQ"
    faqSubtitle="Compatibility, checkout, updates, and risk, answered before you pick a tier."
    trustHeading={productHubExpansion.trustHeading}
    trustItems={productHubExpansion.trustItems}
    cta={productHubExpansion.cta}
  />
</BaseLayout>
